# Gemini API key for the AI Heritage Guide.
# Get this from Google AI Studio or a Google Cloud Gemini setup.
GEMINI_API_KEY=your_gemini_api_key_here

PORT=3001

# Optional: server-side Google Places API (New) nearby hotel/restaurant lookup.
# Google Maps links in the UI work without this key.
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
GOOGLE_MAPS_ENABLED=false
